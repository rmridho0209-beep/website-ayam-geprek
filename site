
<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Geprek Juara | Ayam Geprek Enak</title>
<style>
:root {
  --red: #d92727;
  --dark: #241b18;
  --orange: #ff9e24;
  --cream: #fff8ee;
}
* {box-sizing:border-box;margin:0;padding:0}
body {
  font-family: Arial, sans-serif;
  background:var(--cream);
  color:var(--dark);
}
header {
  background:white;
  padding:16px 7%;
  display:flex;
  justify-content:space-between;
  align-items:center;
  position:sticky;
  top:0;
  z-index:10;
  box-shadow:0 2px 12px #0001;
}
.logo {font-size:23px;font-weight:900;color:var(--red)}
.logo span {color:var(--orange)}
nav {display:flex;gap:22px}
nav a {text-decoration:none;color:var(--dark);font-weight:bold}
.cart-button {
  background:var(--red);color:white;border:0;
  padding:11px 18px;border-radius:25px;
  font-weight:bold;cursor:pointer;
}
.hero {
  padding:75px 8%;
  background:linear-gradient(110deg,#241b18ee,#241b1880),
  url('https://images.unsplash.com/photo-1626082927389-6cd097cdc6ec?w=1400')
  center/cover;
  color:white;
  min-height:410px;
  display:flex;align-items:center;
}
.hero-content {max-width:600px}
.hero h1 {font-size:clamp(38px,6vw,65px);margin:15px 0}
.hero h1 span {color:var(--orange)}
.hero p {font-size:17px;line-height:1.7}
.hero button {
  background:var(--orange);border:0;
  padding:15px 25px;border-radius:8px;
  margin-top:25px;font-weight:bold;cursor:pointer;
}
section {padding:65px 8%}
.section-title{text-align:center;margin-bottom:35px}
.section-title h2 {font-size:32px;margin-bottom:10px}
.section-title p {color:#777}
.categories {
 display:flex;justify-content:center;gap:10px;
 flex-wrap:wrap;margin-bottom:30px
}
.categories button {
 padding:10px 18px;border:1px solid #ddd;
 border-radius:30px;background:white;cursor:pointer
}
.categories button.active {
 background:var(--red);color:white;border-color:var(--red)
}
.menu-grid {
 display:grid;
 grid-template-columns:repeat(auto-fit,minmax(220px,1fr));
 gap:22px;
}
.menu-card {
 background:white;border-radius:15px;overflow:hidden;
 box-shadow:0 5px 20px #0000000c;
 transition:.2s;
}
.menu-card:hover {transform:translateY(-5px)}
.menu-card img {width:100%;height:175px;object-fit:cover}
.menu-info {padding:17px}
.menu-info h3 {margin-bottom:8px}
.menu-info p {font-size:13px;color:#777;min-height:35px}
.price {color:var(--red);font-weight:900;font-size:19px;margin:13px 0}
.menu-info button {
 width:100%;padding:12px;background:var(--red);
 border:0;border-radius:8px;color:white;
 font-weight:bold;cursor:pointer
}
.promo {
 background:var(--red);color:white;text-align:center;
 border-radius:20px;padding:35px 20px;
}
.promo h2 {font-size:30px;margin-bottom:10px}
.about {
 display:grid;grid-template-columns:1fr 1fr;
 gap:35px;align-items:center
}
.about img {width:100%;border-radius:18px}
.about p {line-height:1.8;color:#666;margin-top:15px}
footer {background:var(--dark);color:white;padding:40px 8%;text-align:center}
footer p {color:#ccc;margin-top:10px}
.cart-panel {
 position:fixed;right:-420px;top:0;width:min(400px,100%);
 height:100vh;background:white;z-index:30;
 padding:24px;box-shadow:-5px 0 25px #0002;
 transition:.3s;overflow:auto;
}
.cart-panel.open {right:0}
.cart-header {display:flex;justify-content:space-between;margin-bottom:25px}
.close {border:0;background:none;font-size:25px;cursor:pointer}
.cart-item {
 display:flex;justify-content:space-between;
 gap:12px;border-bottom:1px solid #eee;
 padding:15px 0;
}
.cart-item small {display:block;color:#777;margin-top:5px}
.qty button {
 padding:4px 9px;border:0;background:#eee;
 border-radius:4px;cursor:pointer
}
.total {font-size:20px;font-weight:bold;margin:25px 0}
.checkout {
 width:100%;background:#168b48;color:white;
 padding:15px;border:0;border-radius:9px;
 font-weight:bold;cursor:pointer
}
.empty {color:#888;text-align:center;padding:40px 0}
.overlay {
 display:none;position:fixed;inset:0;
 background:#0007;z-index:20
}
.overlay.show {display:block}
input,textarea,select {
 width:100%;padding:12px;margin:8px 0;
 border:1px solid #ddd;border-radius:7px;
 font:inherit
}
@media(max-width:650px) {
 header {padding:14px 5%}
 nav {display:none}
 .hero {padding:55px 7%;min-height:350px}
 section {padding:45px 6%}
 .about {grid-template-columns:1fr}
}
</style>
</head>
<body>

<header>
 <div class="logo">GEPREK<span>JUARA.</span></div>
 <nav>
  <a href="#home">Beranda</a>
  <a href="#menu">Menu</a>
  <a href="#about">Tentang Kami</a>
 </nav>
 <button class="cart-button" onclick="openCart()">
  🛒 Keranjang (<span id="cart-count">0</span>)
 </button>
</header>

<main>
<section class="hero" id="home">
 <div class="hero-content">
  <p>🔥 PEDASNYA BIKIN KETAGIHAN!</p>
  <h1>Ayam Geprek <span>Juara</span></h1>
  <p>Ayam crispy, sambal pilihan, dan nasi hangat.
  Nikmati sensasi pedas yang bikin makan semakin nikmat!</p>
  <button onclick="document.getElementById('menu').scrollIntoView({behavior:'smooth'})">
   PESAN SEKARANG →
  </button>
 </div>
</section>

<section id="menu">
 <div class="section-title">
  <h2>Menu Favorit Kami 🍗</h2>
  <p>Pilih menu kesukaanmu dan nikmati kelezatannya.</p>
 </div>

 <div class="categories">
  <button class="active" onclick="filterMenu('Semua',this)">Semua</button>
  <button onclick="filterMenu('Paket',this)">Paket Geprek</button>
  <button onclick="filterMenu('Minuman',this)">Minuman</button>
  <button onclick="filterMenu('Tambahan',this)">Tambahan</button>
 </div>
 <div class="menu-grid" id="menu-grid"></div>
</section>

<section>
 <div class="promo">
  <h2>🔥 PROMO SPESIAL HARI INI!</h2>
  <p>Beli menu favoritmu sekarang dan nikmati kelezatannya.</p>
 </div>
</section>

<section class="about" id="about">
 <img src="https://images.unsplash.com/photo-1626082927389-6cd097cdc6ec?w=800" alt="Ayam crispy">
 <div>
  <h2>Tentang Geprek Juara</h2>
  <p>Kami menghadirkan ayam geprek dengan bahan pilihan,
  ayam crispy yang renyah, dan sambal yang dibuat segar.
  Setiap hidangan disiapkan untuk memberikan pengalaman
  makan yang lezat dan memuaskan.</p>
  <p><b>Alamat:</b> Isi alamat toko kamu</p>
  <p><b>Jam buka:</b> 10.00 – 22.00 WIB</p>
  <p><b>Pesanan:</b> Online dan langsung di toko</p>
 </div>
</section>
</main>

<footer>
 <h2>GEPREK JUARA.</h2>
 <p>Pedasnya Juara, Rasanya Istimewa!</p>
 <p>© 2026 Geprek Juara. All Rights Reserved.</p>
</footer>

<div class="overlay" id="overlay" onclick="closeCart()"></div>
<aside class="cart-panel" id="cart">
 <div class="cart-header">
  <h2>Keranjang Belanja 🛒</h2>
  <button class="close" onclick="closeCart()">×</button>
 </div>
 <div id="cart-items"></div>
 <div class="total">Total: <span id="total">Rp0</span></div>

 <h3>Data Pemesan</h3>
 <input id="customer" placeholder="Nama lengkap">
 <textarea id="address" placeholder="Alamat pengiriman"></textarea>
 <select id="payment">
  <option value="COD">Bayar COD</option>
  <option value="Transfer">Transfer bank</option>
  <option value="QRIS">QRIS (konfirmasi pembayaran)</option>
 </select>
 <button class="checkout" onclick="checkout()">
  Pesan melalui WhatsApp
 </button>
</aside>

<script>
// GANTI DENGAN NOMOR WHATSAPP TOKO KAMU
const WHATSAPP = "6283109242989";

const products = [
 {id:1,name:"Ayam Geprek Original",category:"Paket",price:15000,
 desc:"Ayam crispy + sambal original + nasi",
 image:"https://images.unsplash.com/photo-1626082927389-6cd097cdc6ec?w=600"},
 {id:2,name:"Ayam Geprek Keju",category:"Paket",price:20000,
 desc:"Ayam crispy dengan topping keju",
 image:"https://images.unsplash.com/photo-1562967914-608f82629710?w=600"},
 {id:3,name:"Ayam Geprek Mozarella",category:"Paket",price:23000,
 desc:"Ayam geprek dengan lelehan keju",
 image:"https://images.unsplash.com/photo-1606755962773-d324e0a13086?w=600"},
 {id:4,name:"Paket Geprek Komplit",category:"Paket",price:25000,
 desc:"Ayam, nasi, tahu, tempe dan sambal",
 image:"https://images.unsplash.com/photo-1562967914-608f82629710?w=600"},
 {id:5,name:"Es Teh Manis",category:"Minuman",price:5000,
 desc:"Teh segar dengan es",
 image:"https://images.unsplash.com/photo-1556679343-c7306c1976bc?w=600"},
 {id:6,name:"Es Jeruk",category:"Minuman",price:7000,
 desc:"Minuman jeruk segar",
 image:"https://images.unsplash.com/photo-1513558161293-cdaf765edfd4?w=600"},
 {id:7,name:"Nasi Putih",category:"Tambahan",price:5000,
 desc:"Nasi putih hangat",
 image:"https://images.unsplash.com/photo-1516684732162-798a0062be99?w=600"},
 {id:8,name:"Telur Dadar",category:"Tambahan",price:5000,
 desc:"Telur dadar gurih",
 image:"https://images.unsplash.com/photo-1525351484163-7529414344d8?w=600"}
];

let cart = [];
let activeCategory = "Semua";

const rupiah = n => "Rp" + n.toLocaleString("id-ID");

function renderMenu() {
 const list = products.filter(p =>
  activeCategory === "Semua" || p.category === activeCategory
 );
 document.getElementById("menu-grid").innerHTML = list.map(p => `
  <article class="menu-card">
   <img src="${p.image}" alt="${p.name}" loading="lazy">
   <div class="menu-info">
    <h3>${p.name}</h3>
    <p>${p.desc}</p>
    <div class="price">${rupiah(p.price)}</div>
    <button onclick="addToCart(${p.id})">+ Tambah ke Keranjang</button>
   </div>
  </article>
 `).join("");
}

function filterMenu(category,button) {
 activeCategory = category;
 document.querySelectorAll(".categories button").forEach(b=>b.classList.remove("active"));
 button.classList.add("active");
 renderMenu();
}

function addToCart(id) {
 const item = cart.find(p=>p.id===id);
 if(item) item.qty++;
 else cart.push({...products.find(p=>p.id===id),qty:1});
 renderCart();
 openCart();
}

function changeQty(id,amount) {
 const item = cart.find(p=>p.id===id);
 if(!item) return;
 item.qty += amount;
 if(item.qty<=0) cart=cart.filter(p=>p.id!==id);
 renderCart();
}

function renderCart() {
 const count = cart.reduce((sum,p)=>sum+p.qty,0);
 const total = cart.reduce((sum,p)=>sum+p.price*p.qty,0);
 document.getElementById("cart-count").textContent=count;
 document.getElementById("total").textContent=rupiah(total);

 document.getElementById("cart-items").innerHTML = cart.length
 ? cart.map(p=>`
  <div class="cart-item">
   <div><b>${p.name}</b>
   <small>${rupiah(p.price)} × ${p.qty}</small></div>
   <div class="qty">
    <button onclick="changeQty(${p.id},-1)">−</button>
    ${p.qty}
    <button onclick="changeQty(${p.id},1)">+</button>
   </div>
  </div>
 `).join("")
 : '<div class="empty">Keranjang masih kosong 🍗</div>';
}

function openCart() {
 document.getElementById("cart").classList.add("open");
 document.getElementById("overlay").classList.add("show");
}

function closeCart() {
 document.getElementById("cart").classList.remove("open");
 document.getElementById("overlay").classList.remove("show");
}

function checkout() {
 if(cart.length===0) return alert("Keranjang masih kosong!");
 const name=document.getElementById("customer").value.trim();
 const address=document.getElementById("address").value.trim();
 const payment=document.getElementById("payment").value;

 if(!name || !address)
  return alert("Isi nama dan alamat terlebih dahulu!");
 if(!/^62\d{8,15}$/.test(WHATSAPP))
  return alert("Nomor WhatsApp toko belum diatur dengan benar!");

 const total=cart.reduce((sum,p)=>sum+p.price*p.qty,0);
 let message="*PESANAN GEPREK JUARA*%0A%0A";
 message+="Nama: "+encodeURIComponent(name)+"%0A";
 message+="Alamat: "+encodeURIComponent(address)+"%0A%0A";
 message+="*Daftar Pesanan:*%0A";

 cart.forEach(p=>{
  message+=encodeURIComponent(p.name)+" x"+p.qty+
  " = "+encodeURIComponent(rupiah(p.price*p.qty))+"%0A";
 });

 message+="%0A*Total: "+encodeURIComponent(rupiah(total))+"*%0A";
 message+="Metode pembayaran: "+encodeURIComponent(payment);

 window.open("https://wa.me/"+WHATSAPP+"?text="+message,"_blank");
}

renderMenu();
renderCart();
</script>
</body>
</html>
